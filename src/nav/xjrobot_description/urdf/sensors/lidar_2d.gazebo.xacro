<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <!-- 2D 激光仿真配置 -->
  <xacro:macro name="xjrobot_lidar_2d_gazebo" params="laser_2d_visual:=false">
    <gazebo reference="lidar_2d_link">
      <material>Gazebo/Orange</material>
      <sensor type="gpu_lidar" name="lds_lfcd_sensor">
        <pose>0 0 0 0 0 0</pose>
        <topic>scan</topic>
        <gz_frame_id>lidar_2d_link</gz_frame_id>
        <visualize>${laser_2d_visual}</visualize>
        <update_rate>10</update_rate>
        <lidar>
          <scan>
            <horizontal>
              <samples>1387</samples>
              <resolution>1</resolution>
              <min_angle>-1.937315</min_angle>
              <max_angle>1.937315</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0.0</min_angle>
              <max_angle>0.0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.1</min>
            <max>20</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>
