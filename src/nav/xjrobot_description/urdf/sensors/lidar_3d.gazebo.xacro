<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <!-- 3D 激光仿真配置（Mid360 近似） -->
  <xacro:macro name="xjrobot_lidar_3d_gazebo" params="laser_3d_visual:=true">
    <gazebo reference="lidar_3d_link">
      <material>Gazebo/Grey</material>
      <sensor type="gpu_lidar" name="laser_livox">
        <pose>0 0 0.0 0 0 0</pose>
        <topic>/livox/scan3d</topic>
        <gz_frame_id>lidar_3d_link</gz_frame_id>
        <visualize>${laser_3d_visual}</visualize>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <lidar>
          <scan>
            <horizontal>
              <samples>500</samples>
              <resolution>1</resolution>
              <min_angle>-3.1415926535897931</min_angle>
              <max_angle>3.1415926535897931</max_angle>
            </horizontal>
            <vertical>
              <samples>40</samples>
              <resolution>1</resolution>
              <min_angle>-0.12217304763960307</min_angle>
              <max_angle>0.9075712110370514</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.1</min>
            <max>70.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.02</stddev>
          </noise>
        </lidar>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>
