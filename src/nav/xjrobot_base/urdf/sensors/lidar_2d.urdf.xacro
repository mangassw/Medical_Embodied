<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <!-- 实机专用 2D 雷达模型。当前安装关系与仿真版本保持一致。 -->
  <xacro:macro name="xjrobot_lidar_2d">
    <link name="lidar_2d_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <cylinder length="0.025" radius="0.04" />
        </geometry>
        <material name="orange" />
      </visual>
      <visual>
        <origin xyz="0 0 -0.03" rpy="0 0 0" />
        <geometry>
          <cylinder length="0.08" radius="0.01" />
        </geometry>
        <material name="orange" />
      </visual>
    </link>

    <joint name="joint_lidar_2d" type="fixed">
      <!-- 固定 TF: base_link -> lidar_2d_link
           实机版本当前与仿真保持一致，xyz=(0.16, 0, 0.22), rpy=(0, 0, 0)。
           后续调整 2D 雷达安装位置，请修改这里。 -->
      <origin xyz="0.16 0 0.22" rpy="0 0 0" />
      <parent link="base_link" />
      <child link="lidar_2d_link" />
      <axis xyz="0 0 0" />
      <safety_controller k_velocity="0" />
    </joint>
  </xacro:macro>
</robot>
