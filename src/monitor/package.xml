<?xml version="1.0"?>
<package format="3">
  <name>monitor</name>
  <version>0.0.2</version>
  <description>Monitor publishers and detection services including bed detection (YOLOv8 + CLIP) and L515 camera driver.</description>
  <maintainer email="val@todo.todo">val</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>interfaces</depend>

  <!-- Python第三方依赖 -->
  <exec_depend>opencv-python</exec_depend>
  <exec_depend>numpy</exec_depend>
  <exec_depend>ultralytics</exec_depend>
  <exec_depend>open-clip-torch</exec_depend>
  <exec_depend>torch</exec_depend>
  <exec_depend>torchvision</exec_depend>
  <exec_depend>Pillow</exec_depend>

  <!-- L515 C++ camera node needs OpenCV (system) and librealsense2 (system, found via CMake) -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
