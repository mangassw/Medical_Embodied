        {
          "t_ns": 1793340824009373060,
          "text": "好呀，"
        },
        {
          "t_ns": 1793340824061217890,
          "text": "有个人问护士："
        },
        {
          "t_ns": 1793340824203856616,
          "text": "我这病能治好吗？"
        },
        {
          "t_ns": 1793340824204465357,
          "text": "护士说："
        },
        {
          "t_ns": 1793340824204876879,
          "text": "能，"
        },
        {
          "t_ns": 1793340824283451465,
          "text": "但得少熬夜。"
        },
        {
          "t_ns": 1793340824284093232,
          "text": "他愣了下："
        },
        {
          "t_ns": 1793340824350538920,
          "text": "那我昨晚白熬了？"
