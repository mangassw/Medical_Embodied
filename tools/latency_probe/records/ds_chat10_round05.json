        {
          "t_ns": 1793340823951295848,
          "text": "好"
        },
        {
          "t_ns": 1793340823993540753,
          "text": "呀"
        },
        {
          "t_ns": 1793340824009148694,
          "text": "，有"
        },
        {
          "t_ns": 1793340824027821357,
          "text": "个人"
        },
        {
          "t_ns": 1793340824049477257,
          "text": "问"
        },
        {
          "t_ns": 1793340824061026467,
          "text": "护士："
        },
        {
          "t_ns": 1793340824077483488,
          "text": "我这"
        },
        {
          "t_ns": 1793340824144460655,
          "text": "病"
        },
        {
          "t_ns": 1793340824200316357,
          "text": "能治好吗"
        },
        {
          "t_ns": 1793340824203622607,
          "text": "？"
        },
        {
          "t_ns": 1793340824203822820,
          "text": "护士说：能"
        },
        {
          "t_ns": 1793340824204044725,
          "text": "，但"
        },
        {
          "t_ns": 1793340824204200660,
          "text": "得"
        },
        {
          "t_ns": 1793340824282960139,
          "text": "少"
        },
        {
          "t_ns": 1793340824283197511,
          "text": "熬夜。他"
        },
        {
          "t_ns": 1793340824283411973,
          "text": "愣了下"
        },
        {
          "t_ns": 1793340824283672863,
          "text": "：那我"
        },
        {
          "t_ns": 1793340824283883619,
          "text": "昨晚"
        },
        {
          "t_ns": 1793340824350136502,
          "text": "白"
        },
        {
          "t_ns": 1793340824350365828,
          "text": "熬了？"
        }
      ]
    },
